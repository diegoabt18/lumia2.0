# =============================================================================
# Lumia 2.0 - Variables de entorno
# =============================================================================
# Copia este archivo como `.env` para desarrollo local con `npm run dev`.
#
# Nuxt mapea cada variable a `runtimeConfig` por convención de nombres:
#   NUXT_JWT_SECRET              -> runtimeConfig.jwtSecret
#   NUXT_PUBLIC_STORE_CURRENCY   -> runtimeConfig.public.storeCurrency
#
# En Cloudflare Workers los valores NO se leen de este archivo:
#   - Para `wrangler dev` en local, copia `.dev.vars.example` → `.dev.vars`.
#   - Para produccion: edita `NUXT_SITE_URL` en wrangler.jsonc (env.production)
#     y sube secretos con `npm run cf:secrets:prod`.
#   - Deploy: `npm run cf:deploy:prod`
# =============================================================================

# --- Sitio ---------------------------------------------------------------
NUXT_SITE_URL=http://localhost:3000

# --- Autenticacion -------------------------------------------------------
# Genera secretos con: node -e "console.log(crypto.randomUUID()+crypto.randomUUID())"
NUXT_JWT_SECRET=
NUXT_JWT_REFRESH_SECRET=
NUXT_GOOGLE_CLIENT_ID=
NUXT_GOOGLE_CLIENT_SECRET=

# --- MongoDB Atlas -------------------------------------------------------
# Un solo cluster M0 gratuito con cuatro bases logicas separadas por dominio.
# Usa un usuario de base de datos distinto por dominio, con permisos minimos.
NUXT_MONGO_AUTH_URI=
NUXT_MONGO_CATALOG_URI=
NUXT_MONGO_SALES_URI=

# --- Catálogo D1 (edge read) ---------------------------------------------
# mongo = solo MongoDB (default, seguro)
# d1    = solo D1 (requiere binding CATALOG_DB + schema aplicado)
# auto  = D1 si hay binding, si no Mongo
# auto  = D1 si hay binding y datos sync; si no Mongo (recomendado con cf:dev)
NUXT_CATALOG_SOURCE=auto

# --- Emails (Resend) -----------------------------------------------------
NUXT_RESEND_API_KEY=
# Ej. LUMIA <pedidos@tudominio.com> — dominio verificado en Resend
NUXT_RESEND_FROM=
# Aviso interno cuando entra un pedido nuevo
NUXT_ORDER_NOTIFY_EMAIL=

# --- Seguridad (Cloudflare Turnstile) ------------------------------------
NUXT_TURNSTILE_SECRET_KEY=
NUXT_PUBLIC_TURNSTILE_SITE_KEY=

# --- Pagos (Mercado Pago) ------------------------------------------------
NUXT_MP_ACCESS_TOKEN=
NUXT_MP_WEBHOOK_SECRET=
NUXT_PUBLIC_MP_PUBLIC_KEY=

# --- Pedidos -------------------------------------------------------------
NUXT_ORDER_NUMBER_PREFIX=ORD
NUXT_ORDER_PAYMENT_TTL_HOURS=24
NUXT_ORDER_MANUAL_PAYMENT_TTL_HOURS=72
# Secreto para cron jobs protegidos (`Authorization: Bearer` o header `X-Cron-Secret`):
#   POST /api/cron/expire-orders
#   POST /api/cron/sync-catalog   (Fase 4 — sync Mongo → D1)
NUXT_CRON_SECRET=

# --- Tienda --------------------------------------------------------------
NUXT_PUBLIC_STORE_CURRENCY=COP
NUXT_PUBLIC_STORE_LOCALE=es-CO
NUXT_PUBLIC_STORE_TIMEZONE=America/Bogota
NUXT_PUBLIC_STORE_BESTSELLER_TOP_N=8
NUXT_PUBLIC_STORE_POPULAR_MIN_UNITS=3
NUXT_PUBLIC_CART_CONTINUE_SHOPPING_PATH=/products
NUXT_PUBLIC_CART_PAGE_NO_INDEX=false
# Umbral COP para barra "envío gratis" en carrito; 0 = desactivada
NUXT_PUBLIC_STORE_FREE_SHIPPING_THRESHOLD=0
# Tarifa fija de envío COP; 0 = se coordina con el vendedor (no se suma al total)
NUXT_PUBLIC_STORE_SHIPPING_FLAT_RATE=0
NUXT_PUBLIC_AUTH_LOCAL_PROVIDER_ENABLED=false

# --- Ventas por WhatsApp -------------------------------------------------
# Formato E.164 sin el signo +, por ejemplo 573001234567
NUXT_PUBLIC_WHATSAPP_PHONE=

# --- Imagenes (GitHub + jsDelivr) ----------------------------------------
# Sin barra final. Ejemplo:
# https://cdn.jsdelivr.net/gh/diegoabt18/lumia_images@main/products
NUXT_PUBLIC_PRODUCT_IMAGES_CDN_BASE=
# Hero home: {CDN sin /products}/home/image_1.avif, image_2.avif, …
NUXT_PUBLIC_HOME_HERO_MAX_SLIDES=8
NUXT_PUBLIC_HOME_HERO_SLIDE_INTERVAL_MS=5500
# Galería momentos: {CDN sin /products}/moments/image_1.avif, image_2.avif, …
NUXT_PUBLIC_HOME_MOMENTS_MAX_IMAGES=12
NUXT_PUBLIC_PRODUCT_IMAGE_GALLERY_LAYOUT=flat
